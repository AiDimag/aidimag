{
  "name": "aidimag",
  "version": "1.1.2",
  "description": "Persistent, verified memory for AI coding agents. CLI: dim.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Anup Khanal",
    "url": "https://github.com/anup-khanal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiDimag/aidimag.git"
  },
  "homepage": "https://aidimag.com",
  "mcpName": "io.github.AiDimag/aidimag",
  "bugs": {
    "url": "https://github.com/AiDimag/aidimag/issues"
  },
  "bin": {
    "dim": "dist/cli/index.js",
    "aidimag": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "integrations/hermes/aidimag_hermes_provider.py",
    "server.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "mcp": "node dist/mcp/server.js",
    "registry:sync": "node scripts/sync-server-json.mjs",
    "registry:publish": "npm run registry:sync && npx mcp-publisher publish",
    "pretest": "tsc",
    "test": "node --test dist/test/*.test.js",
    "bench": "npm run build && node benchmark/run.mjs",
    "bench:quick": "npm run build && node benchmark/run.mjs --quick",
    "bench:quality": "npm run build && node benchmark/quality.mjs",
    "version": "npm run registry:sync && git add server.json",
    "prepublishOnly": "npm run build && npm test && npm run registry:sync",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "memory",
    "codebase",
    "claude",
    "cursor",
    "copilot",
    "knowledge-base",
    "cli"
  ],
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1108.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^13.0.1",
    "commander": "^12.0.0",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.1",
    "sqlite-vec": "^0.1.9",
    "uuid": "^12.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitepress": "2.0.0-alpha.17"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.0.5",
    "tar-stream": "^3.1.7"
  }
}
